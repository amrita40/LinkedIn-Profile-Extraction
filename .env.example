# --- Required: LinkedIn session cookies (see README "Setup" for how to get these) ---
LI_AT=
JSESSIONID=

# --- Optional: protect your own hosted endpoint with a key clients must send
# as the X-API-Key header. Leave blank to run the API open (fine for local testing). ---
API_KEY=

# --- Optional tuning ---
CACHE_TTL_SECONDS=3600
RATE_LIMIT_PER_MINUTE=20
REQUEST_TIMEOUT_SECONDS=15
